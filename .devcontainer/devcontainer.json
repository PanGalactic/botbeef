{
  "name": "BOT BEEF",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install --no-cache-dir flask requests anthropic",
  "forwardPorts": [5050],
  "portsAttributes": {
    "5050": { "label": "BOT BEEF", "onAutoForward": "openBrowser" }
  },
  "postAttachCommand": "python3 app.py",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  },
  "remoteEnv": {
    "BOTBEEF_PORT": "5050"
  }
}
