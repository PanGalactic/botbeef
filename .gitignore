# Rendered audio — regenerate with ingest/pregen.py, don't bloat the repo
audio/*.wav

# Raw scrape output — big, and reproducible from the ingest scripts
data/raw/*.html
data/raw/robots/
data/raw/photos/
data/raw/chatter_*.json
data/raw/snapshots.json
data/*.sqlite3
data/*.sqlite3-*

# Flat FLUX renders before the cutout step. Intermediates: the finished
# sprites in static/bots_tekken/ are what the app uses.
data/raw/tekken/

# Secrets. Never commit a Bright Data or Anthropic token.
.env
*.key
secrets.json

__pycache__/
*.py[cod]
.pytest_cache/
.pytest-tmp*/
.venv/
venv/
.DS_Store
